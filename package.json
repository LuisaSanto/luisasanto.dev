{
  "name": "luisa-santo-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "serve out --listen tcp://127.0.0.1:4173 --no-clipboard",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "resume:pdf": "node scripts/export-resume.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "serve": "14.2.6",
    "typescript": "5.9.3"
  }
}
